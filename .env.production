# Public values baked into the production build. None of these are secrets:
# the email and phone are printed on the page, and the form endpoint is in the
# page source by design. Anything secret belongs in Vercel, never here.
# Values set in the Vercel dashboard override this file.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://formsubmit.co/ajax/info@traionis.com
NEXT_PUBLIC_CONTACT_EMAIL=info@traionis.com
NEXT_PUBLIC_CONTACT_PHONE=+359 877 832 852
